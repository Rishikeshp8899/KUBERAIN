e><table schema="main" name="work_packages" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="31"/><column index="2" value="50"/><column index="3" value="82"/><column index="4" value="228"/><column index="5" value="300"/><column index="6" value="271"/><column index="7" value="86"/><column index="8" value="85"/><column index="9" value="103"/><column index="10" value="77"/><column index="11" value="112"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- 1. Insert a sample supplier (if not already present)
INSERT OR IGNORE INTO suppliers (id, company_name, city, state, contact_email, phone, gst_number, msme_reg_number, is_verified, iso_standard, plant_area_sq_ft, worker_count, rating, capabilities_summary, nda_signed, created_at) 
VALUES (1, 'Apex Valve Works Pvt Ltd', 'Thane', 'Maharashtra', 'contact@apexvalve.in', '+91 9876543210', '27AABCA1234F1Z5', 'UDYAM-MH-03-001', 1, 'ISO 9001:2015', 12500, 45, 4.8, '5-Axis CNC Milling, Ball Valves, Inconel Machining', 1, datetime('now'));

-- 2. Insert Active / Current Work Package
INSERT OR IGNORE INTO work_packages (id, rfq_id, supplier_id, title, redacted_spec, redacted_drawing_path, budget_usd, target_date, escrow_status, status, created_at) 
VALUES (201, 101, 1, 'High-Pressure SS316L Valve Body Machining', 'Fabricate 500 units of high-pressure valve bodies using 5-axis CNC. Material: SS316L.', 'static/uploads/redacted/valve_body_v2_redacted.step', 15000.00, '2026-12-10', 'Escrow_Held', 'In Production', datetime('now'));

-- 3. Insert Completed Work Package
INSERT OR IGNORE INTO work_packages (id, rfq_id, supplier_id, title, redacted_spec, redacted_drawing_path, budget_usd, target_date, escrow_status, status, created_at) 
VALUES (202, 102, 1, 'Cryogenic Gate Valve Assembly', 'Assembly and testing of 200 units cryogenic valves.', 'static/uploads/redacted/gate_valve_redacted.pdf', 24000.00, '2026-11-20', 'Released', 'Completed', datetime('now'));</sql><current_tab id="0"/></tab_sql></sqlb_project>
